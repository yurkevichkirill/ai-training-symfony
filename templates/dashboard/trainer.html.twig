{% extends 'base.html.twig' %}

{% block title %}Trainer dashboard{% endblock %}

{% block h1 %}Trainer dashboard{% endblock %}

{% block body %}
    <p class="meta">Signed in as {{ app.user.email }}.</p>

    <nav aria-label="Dashboard">
        <ul>
            <li><a href="{{ path('app_trainer_players') }}">Players roster</a></li>
            <li><a href="{{ path('app_trainer_coaches') }}">Coaches</a></li>
            <li><a href="{{ path('app_trainer_share_link') }}">Share link</a></li>
            <li><a href="{{ path('app_profile_edit') }}">My profile</a></li>
            <li><a href="{{ path('app_trainer_branding') }}">Branding</a></li>
        </ul>
    </nav>

    <form method="post" action="{{ path('app_logout') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <div class="actions">
            <button type="submit">Sign out</button>
        </div>
    </form>
{% endblock %}
