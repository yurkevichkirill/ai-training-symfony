{% if is_granted('IS_IMPERSONATOR') %}
    <div class="impersonation-banner" role="status">
        <span class="impersonation-banner__icon" aria-hidden="true">⚠</span>
        <strong>Impersonation</strong>
        — Viewing as {{ app.user.displayName }} ({{ app.user.role.value }})
        <a href="{{ path('app_home', {_switch_user: '_exit'}) }}">Exit Impersonation</a>
    </div>
{% endif %}
