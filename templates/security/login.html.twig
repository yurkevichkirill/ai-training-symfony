{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <main>
        <h1>Sign in</h1>

        {# One message for every failure cause -- see UniformAuthenticationFailureHandler. #}
        {% for message in app.flashes('error') %}
            <p role="alert">{{ message }}</p>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <p role="status">{{ message }}</p>
        {% endfor %}

        <form method="post" action="{{ path('app_login') }}">
            <label for="username">Email</label>
            <input type="email" id="username" name="_username" autocomplete="username" required autofocus>

            <label for="password">Password</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>

            {# Stateless CSRF: the value is the cookie name, and validation is
               same-origin based. See the Task 2 config verification notes. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit">Sign in</button>
        </form>

        {# Task 31 adds the app_forgot_password_request route and links it here. #}
    </main>
{% endblock %}
