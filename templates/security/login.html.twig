{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block h1 %}Sign in{% endblock %}

{% block body %}
    {# `app.flashes()` pops the flash bag, so it is read exactly once here and
       reused below -- a second call would see an empty array. #}
    {% set login_errors = app.flashes('error') %}
    {% set has_login_error = login_errors|length > 0 %}

    {# One message for every failure cause -- see UniformAuthenticationFailureHandler.
       Linking the message itself back to the email field gives assistive
       technology and keyboard users a concrete place to retry (AC-22); the
       uniform handler never discloses which field was wrong, so both fields
       below are marked invalid together rather than singling one out. #}
    {% for message in login_errors %}
        <p role="alert" id="login-error"><a href="#username">{{ message }}</a></p>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <p role="status" class="status-message">{{ message }}</p>
    {% endfor %}

    <form method="post" action="{{ path('app_login') }}">
        <div class="form-row{% if has_login_error %} form-row--invalid{% endif %}">
            <label for="username">Email</label>
            <input
                type="email"
                inputmode="email"
                id="username"
                name="_username"
                autocomplete="email"
                required
                autofocus
                {%- if has_login_error %} aria-invalid="true" aria-describedby="login-error"{% endif %}
            >
        </div>

        <div class="form-row{% if has_login_error %} form-row--invalid{% endif %}">
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="_password"
                autocomplete="current-password"
                required
                {%- if has_login_error %} aria-invalid="true" aria-describedby="login-error"{% endif %}
            >
        </div>

        {# Stateless CSRF: the value is the cookie name, and validation is
           same-origin based. See the Task 2 config verification notes. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="actions">
            <button type="submit">Sign in</button>
        </div>
    </form>

    <ul class="link-list">
        <li><a href="{{ path('app_forgot_password_request') }}">Forgot your password?</a></li>
    </ul>
{% endblock %}
