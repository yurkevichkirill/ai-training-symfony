<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="/css/app.css">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {# Keyboard-only users can skip straight to the single main landmark
           without tabbing through any repeated chrome (AC-22). #}
        <a class="skip-link" href="#main-content">Skip to main content</a>

        {# S6 (AC-5): one include makes the impersonation banner appear on
           every authenticated route, including every route this slice
           never touches -- the alternative (per-template includes) is a
           rule someone will forget. #}
        {{ include('_impersonation_banner.html.twig') }}

        {# S7 (D3c, AC-6, AC-8, AC-11): one more single include, following
           the same rule as the banner above it -- inert on every page that
           passes no `branding` variable, and it is the only place a
           trainer's logo/color override can render as page chrome. #}
        {{ include('_branding.html.twig') }}

        {# Global flash rendering: every controller across the app calls
           addFlash('success', ...) / addFlash('error', ...) and redirects,
           expecting the next page to show the result. Rendering flashes
           here -- once, unconditionally -- means no template has to opt in,
           the same rule the impersonation banner and branding partial above
           already follow. `success` reuses the `.status-message`/role="status"
           convention already established by login/verify-email/etc.; `error`
           reuses `.alert-message`/role="alert", the same convention used for
           inline failure text elsewhere (see form/_error_summary.html.twig). #}
        <div class="flash-messages">
            {% for message in app.flashes('success') %}
                <p role="status" class="status-message flash-message flash-message--success">{{ message }}</p>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <p role="alert" class="alert-message flash-message flash-message--error">{{ message }}</p>
            {% endfor %}
        </div>

        {# Exactly one <h1> per page: every page template sets the `h1` block
           and nothing else renders a top-level heading, so no page can end up
           with zero or with more than one (AC-22). #}
        <main id="main-content" class="page">
            <h1>{% block h1 %}{% endblock %}</h1>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
