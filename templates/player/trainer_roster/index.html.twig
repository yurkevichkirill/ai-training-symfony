{% extends 'base.html.twig' %}

{% block title %}Your trainers{% endblock %}

{% block h1 %}Your trainers{% endblock %}

{% block body %}
    {% if roster is empty %}
        <p>You are not currently connected with any trainer.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th scope="col">Trainer</th>
                    <th scope="col">Connected since</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for association in roster %}
                    {% set trainerBranding = brandingByTrainer[association.trainer.id.toRfc4122] %}
                    <tr>
                        <td>
                            {% if trainerBranding.hasLogo %}
                                <img src="{{ trainerBranding.logoUrl }}" alt="{{ association.trainer.displayName }} logo" style="max-height: 40px; max-width: 40px; width: auto; vertical-align: middle;">
                            {% endif %}
                            <span style="color: {{ trainerBranding.primaryColorHex }};">{{ association.trainer.displayName }}</span>
                        </td>
                        <td>{{ association.createdAt|date('Y-m-d') }}</td>
                        <td>
                            <form method="post" action="{{ path('app_player_trainers_leave', {id: association.trainer.id}) }}" style="display:inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('player_leave_trainer_' ~ association.trainer.id) }}">
                                <button type="submit">Leave</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
